# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami.
# NIGDY nie wpisuj tu prawdziwych sekretów — ten plik jest commitowany do repo.

# Token PL-VACC API (Developer settings w panelu PL-VACC)
PLVACC_API_TOKEN=

# Właściciel bookingów tworzonych przez przycisk "EXPORT BOOKINGS" (scheduler
# eventu, tryb admina) — CoreVACC wymaga formatu "Imię Nazwisko - CID", np.
# "Jan Kowalski - 1234567". To ZAWSZE konto powiązane z PLVACC_API_TOKEN
# (właściciela klucza API), NIE kontrolera, który faktycznie siedział na
# danej pozycji.
PLVACC_BOOKING_OWNER_NAME=

# Supabase — klucz service_role/secret (Project Settings -> API Keys).
# UWAGA: pełny dostęp do bazy, omija RLS. Tylko po stronie serwera!
SUPABASE_SECRET_KEY=

# Losowy sekret chroniący endpoint /api/cron/roster przed wywołaniem przez
# kogoś z zewnątrz. Ta sama wartość musi być ustawiona jako zmienna
# środowiskowa CRON_SECRET na Vercel.
CRON_SECRET=

# Wspólne hasło "trybu administratora" (patrz lib/adminAuth.js, lib/adminMode.js).
# Bez tego strona działa wyłącznie w trybie zwykłego kontrolera — nikt nie
# może tworzyć/edytować eventów, przypisywać kontrolerów ani synchronizować
# rostera, dopóki nie zaloguje się tym hasłem przez ikonkę kłódki w górnym pasku.
ADMIN_PANEL_PASSWORD=

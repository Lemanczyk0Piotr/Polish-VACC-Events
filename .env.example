# Skopiuj ten plik do .env.local i uzupełnij prawdziwymi wartościami.
# NIGDY nie wpisuj tu prawdziwych sekretów — ten plik jest commitowany do repo.

# Token PL-VACC API (Developer settings w panelu PL-VACC)
PLVACC_API_TOKEN=

# Właściciel bookingów tworzonych przez przycisk "EXPORT BOOKINGS" (scheduler
# eventu, tryb admina) — CoreVACC wymaga formatu "Imię Nazwisko - CID", np.
# "Jan Kowalski - 1234567". To ZAWSZE konto powiązane z PLVACC_API_TOKEN
# (właściciela klucza API), NIE kontrolera, który faktycznie siedział na
# danej pozycji.
PLVACC_BOOKING_OWNER_NAME=

# Supabase — klucz service_role/secret (Project Settings -> API Keys).
# UWAGA: pełny dostęp do bazy, omija RLS. Tylko po stronie serwera!
SUPABASE_SECRET_KEY=

# Losowy sekret chroniący endpoint /api/cron/roster przed wywołaniem przez
# kogoś z zewnątrz. Ta sama wartość musi być ustawiona jako zmienna
# środowiskowa CRON_SECRET na Vercel.
CRON_SECRET=

# Wspólne hasło "trybu administratora" (patrz lib/adminAuth.js, lib/adminMode.js).
# Bez tego strona działa wyłącznie w trybie zwykłego kontrolera — nikt nie
# może tworzyć/edytować eventów, przypisywać kontrolerów ani synchronizować
# rostera, dopóki nie zaloguje się tym hasłem przez ikonkę kłódki w górnym pasku.
ADMIN_PANEL_PASSWORD=

# ---------------------------------------------------------------------------
# Integracja z Discordem (ogłoszenia, przypomnienia, rozpiski, materiały,
# podsumowania miesiąca). Wszystko idzie WEBHOOKAMI — nie ma osobnego procesu
# bota, więc nic poza tymi zmiennymi nie trzeba hostować.
# ---------------------------------------------------------------------------

# Wspólny webhook używany dla każdego kanału, dla którego nie ustawiono
# osobnego URL-a niżej. Na start wystarczy sam ten jeden.
# Skąd wziąć: Discord -> ustawienia kanału -> Integracje -> Webhooki ->
# "Nowy webhook" -> "Kopiuj URL webhooka".
# UWAGA: kto zna ten URL, może pisać na kanał jako bot — traktuj jak hasło.
DISCORD_WEBHOOK_URL=

# Opcjonalny rozdział na osobne kanały (każdy pusty = użyty DISCORD_WEBHOOK_URL)
DISCORD_WEBHOOK_EVENTS=
DISCORD_WEBHOOK_SCHEDULE=
DISCORD_WEBHOOK_MATERIALS=
DISCORD_WEBHOOK_SUMMARY=

# ID roli pingowanej przy ogłoszeniach i przypomnieniach (np. @Controllers).
# Discord -> Ustawienia serwera -> Role -> prawy klik -> "Kopiuj ID roli"
# (wymaga włączonego trybu dewelopera). Puste = brak pingów.
DISCORD_ROLE_ID=

# Nazwa i awatar, pod jakimi bot pisze (opcjonalne).
DISCORD_WEBHOOK_USERNAME=PLVACC Events
DISCORD_WEBHOOK_AVATAR_URL=

# Adres strony — używany do linków "Zapisy / szczegóły" w wiadomościach.
# Bez tego wiadomości nadal działają, ale nie będzie w nich odnośników.
NEXT_PUBLIC_SITE_URL=https://twoja-domena.vercel.app

# --- Reguły automatycznych wysyłek (wszystkie opcjonalne, mają domyślne) ---

# Godzina UTC/Zulu, od której cron może wysyłać powiadomienia dniowe
# (przypomnienia, rozpiski, podsumowanie miesiąca). Chroni przed wysyłką
# o 00:05 w nocy, gdy cron chodzi co godzinę. Domyślnie 18.
DISCORD_REMINDER_HOUR=18

# Ile dni przed eventem lecą przypomnienia. Domyślnie "2,1".
DISCORD_REMINDER_DAYS=2,1

# Ile dni przed eventem leci przypomnienie o ZAPISACH. Domyślnie "5".
DISCORD_SIGNUP_REMINDER_DAYS=5

# Ile dni przed eventem publikowana jest gotowa rozpiska obsady. Domyślnie 1.
DISCORD_SCHEDULE_DAYS_BEFORE=1

# "1" = cron sam ogłasza nowo opublikowane eventy (status "published",
# utworzone w ciągu ostatnich DISCORD_AUTO_ANNOUNCE_MAX_AGE_DAYS dni).
# "0" (domyślnie) = ogłoszenia wychodzą wyłącznie ręcznie, przyciskiem
# "DISCORD" na liście wydarzeń.
DISCORD_AUTO_ANNOUNCE=0
DISCORD_AUTO_ANNOUNCE_MAX_AGE_DAYS=3

# Ilu kontrolerów w podsumowaniu miesiąca i czy pokazywać nazwiska
# (0 = tylko CID, jak w publicznym widoku Top Controllers).
DISCORD_SUMMARY_TOP=10
DISCORD_SUMMARY_SHOW_NAMES=1
